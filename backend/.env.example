# Backend environment variables
# Copy this to .env for local development (never commit .env)

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your Vercel deployment URL.
# Example: https://dns-tunneling.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Encryption ───────────────────────────────────────────────────────────────
# Fernet key used to encrypt stored OpenRouter API keys.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep the same key across all deployments or stored keys become unreadable.
ENCRYPTION_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (auto-creates at local path or /tmp on cloud).
# Set a PostgreSQL URL for persistent data:
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=
